    ],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kitten notify --only-print-escape-code -a 'Claude Code' -i \"claude-${PWD##*/}\" \"Claude · ${PWD##*/}\" \"$(jq -r .message)\" > /dev/$(ps -o tty= -p $PPID | tr -d ' ')"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kitten notify --only-print-escape-code -a 'Claude Code' -i \"claude-${PWD##*/}\" \"Claude · ${PWD##*/}\" 'Done' > /dev/$(ps -o tty= -p $PPID | tr -d ' ')"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(gcloud:* -n prod*)"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: arsen-cybersecurity (GitHub org; repo remote github.com:arsen-cybersecurity/backend.git)",
      "**Cloud provider(s)**: Google Cloud Platform (gcloud CLI used 60× in-project and 10× in shell history; monitoring.googleapis.com and cloudresourcemanager.googleapis.com contacted)",
      "**Repository visibility**: private (arsen-cybersecurity/backend, confirmed via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default and protected, confirmed via gh; no rulesets listed)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: github.com:arsen-cybersecurity/backend.git (origin) — the trusted repo and its remote only",
      "**Trusted internal domains**: api.arsen.co (10× contacted in-project)",
      "**Trusted cloud buckets**: None configured — one bucket name (\"bucket\") appears once in project usage but is too generic/low-confidence to adopt",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured — GitHub Packages used for private dependency auth (gh auth login -s read:packages per README) but no registry host confirmed",
      "**Sensitive data locations & audiences**: .env.dev, .env.prod, and other .env.* files (gitignored except .env.*.template); src/iam/iam.module.ts and src/iam/http-calls/ (identity/auth-related); share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment — includes start:prod:read-only script and .env.prod",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment; src/iam/ module warrants extra caution given repo evidence",
      "### User-specific",
      "**Primary use of Claude Code**: software development (backend Node/NestJS-style service, modulith architecture)",
      "**Trusted repo**: /Users/swann/work/backend (github.com:arsen-cybersecurity/backend.git, private) — confidential material OK to commit here; content ported from outside this repo is not its own work",
      "**Org-specific CLIs**: rtk (4× in-project, 4× in shell history — referenced via ~/.claude/CLAUDE.md's @RTK.md import)",
      "routine under /Users/swann/work/backend/ prefix qualifies for relaxed local-operation treatment"
    ]
  }
}
